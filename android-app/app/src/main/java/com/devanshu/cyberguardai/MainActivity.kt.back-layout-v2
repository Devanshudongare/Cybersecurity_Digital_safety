@Composable
fun SmsScreen(onBack: () -> Unit) {
    val context = androidx.compose.ui.platform.LocalContext.current
    val detector = remember { SmsDetector(context) }
    val repository = remember { LearningRepository(context) }
    val scope = rememberCoroutineScope()
    var message by remember { mutableStateOf("") }
    var result by remember { mutableStateOf<SmsResult?>(null) }
    var error by remember { mutableStateOf<String?>(null) }

    AnalyzerLayout("SMS MESSAGE CHECKER", onBack) {
        Text("Paste or type the SMS message:", color = Color.White, fontSize = 19.sp)
        Spacer(Modifier.height(12.dp))

        OutlinedTextField(
            value = message,
            onValueChange = { message = it; result = null; error = null },
            modifier = Modifier.fillMaxWidth(),
            minLines = 5,
            textStyle = androidx.compose.ui.text.TextStyle(color = Color.White, fontSize = 19.sp),
            placeholder = { Text("Enter SMS here...") },
            colors = fieldColors()
        )

        Spacer(Modifier.height(16.dp))

        ActionButton("CHECK SMS") {
            if (message.isBlank()) {
                error = "Please enter a message first."
                result = null
            } else {
                try {
                    val analyzed = detector.analyze(message)
                    result = analyzed

                    scope.launch {
                        repository.saveScan(
                            analyzer = "SMS",
                            input = message,
                            result = analyzed.classification,
                            riskScore = analyzed.spamProbability
                        )
                    }
                    error = null
                } catch (e: Exception) {
                    error = "Could not analyze message."
                }
            }
        }

        error?.let { Text(it, color = Color.Red, fontSize = 17.sp) }

        result?.let { smsResult ->
            ResultCard(
                heading = when (smsResult.classification) {
                    "Potential Scam" -> "⚠ POSSIBLE FRAUD"
                    "Likely Safe" -> "MESSAGE LOOKS NORMAL"
                    else -> "PLEASE BE CAREFUL"
                },
                explanation = when (smsResult.classification) {
                    "Potential Scam" ->
                        "This message may be trying to steal your money. Do not share OTP or click unknown links."
                    "Likely Safe" ->
                        "This message looks normal. Still check who sent it."
                    else ->
                        "We are not sure about this message. Do not share money or personal details."
                },
                probability = smsResult.spamProbability
            )

            Spacer(Modifier.height(16.dp))

            FeedbackCard(
                analyzer = "SMS",
                inputData = message,
                predictedLabel = smsResult.classification,
                confidence = smsResult.spamProbability,
                possibleLabels = listOf(
                    "Potential Scam",
                    "Likely Safe",
                    "Suspicious"
                )
            )
        }
    }
}

