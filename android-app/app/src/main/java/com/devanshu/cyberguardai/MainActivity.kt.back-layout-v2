@Composable
fun NetworkScreen(onBack: () -> Unit) {
    val context = androidx.compose.ui.platform.LocalContext.current
    val detector = remember { NetworkDetector(context) }
    val repository = remember { LearningRepository(context) }
    val scope = rememberCoroutineScope()
    val featureNames = remember { detector.getFeatureNames() }

    var values by remember { mutableStateOf(mapOf<String, String>()) }
    var result by remember { mutableStateOf<NetworkResult?>(null) }
    var error by remember { mutableStateOf<String?>(null) }

    val visibleFeatures = listOf(
        "Destination Port",
        "Flow Duration",
        "Total Fwd Packets",
        "Total Backward Packets",
        "Total Length of Fwd Packets",
        "Total Length of Bwd Packets"
    )

    AnalyzerLayout("NETWORK TRAFFIC CHECKER", onBack) {
        Text("Enter available network flow values:", color = Color.White, fontSize = 18.sp)
        Spacer(Modifier.height(8.dp))
        Text(
            "Other model features will use training-data median values.",
            color = Color.LightGray,
            fontSize = 14.sp
        )
        Spacer(Modifier.height(12.dp))

        visibleFeatures.forEach { feature ->
            NetworkInputField(
                label = feature,
                value = values[feature] ?: "",
                onValueChange = { newValue ->
                    values = values + (feature to newValue)
                    result = null
                    error = null
                }
            )
            Spacer(Modifier.height(10.dp))
        }

        ActionButton("ANALYZE NETWORK") {
            try {
                val input = mutableMapOf<String, Double?>()

                visibleFeatures.forEach { name ->
                    val text = values[name].orEmpty().trim()
                    input[name] =
                        if (text.isEmpty()) null
                        else text.toDoubleOrNull()
                            ?: throw IllegalArgumentException("Enter a valid number for $name")
                }

                val analyzed = detector.analyze(input)
               result = analyzed

               val networkInput = values.entries.joinToString("; ") { entry ->
                   "${entry.key}=${entry.value}"
               }

               scope.launch {
                   repository.saveScan(
                       analyzer = "NETWORK",
                       input = networkInput,
                       result = analyzed.classification,
                       riskScore = analyzed.suspiciousProbability
                   )
               }
                error = null
            } catch (e: Exception) {
                result = null
                error = e.message ?: "Could not analyze network traffic."
            }
        }

        error?.let { Text(it, color = Color.Red, fontSize = 16.sp) }

        result?.let { networkResult ->
            ResultCard(
                heading = when (networkResult.classification) {
                    "Potential Threat" -> "⚠ POSSIBLE NETWORK THREAT"
                    "Likely Normal Traffic" -> "TRAFFIC LOOKS NORMAL"
                    else -> "SUSPICIOUS TRAFFIC"
                },
                explanation = when (networkResult.classification) {
                    "Potential Threat" ->
                        "This traffic pattern may be suspicious. Investigate its source and destination."
                    "Likely Normal Traffic" ->
                        "This traffic looks normal to the model, but this is not a guarantee."
                    else ->
                        "The model is uncertain. Review this traffic before trusting it."
                },
                probability = networkResult.suspiciousProbability
            )

            Spacer(Modifier.height(16.dp))

            FeedbackCard(
                analyzer = "NETWORK",
                inputData = values.entries.joinToString("; ") { entry ->
                    "${entry.key}=${entry.value}"
                },
                predictedLabel = networkResult.classification,
                confidence = networkResult.suspiciousProbability,
                possibleLabels = listOf(
                    "Potential Threat",
                    "Likely Normal Traffic",
                    "Suspicious Traffic"
                )
            )
        }

        Spacer(Modifier.height(12.dp))
        Text(
            "Demo limitation: only six values are entered manually; remaining features use model medians. CSV analysis can provide fuller data.",
            color = Color.LightGray,
            fontSize = 14.sp
        )
    }
}

@Composable
fun NetworkInputField(label: String, value: String, onValueChange: (String) -> Unit) {
    OutlinedTextField(
        value = value, onValueChange = onValueChange,
        modifier = Modifier.fillMaxWidth(), label = { Text(label) },
        singleLine = true, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
        textStyle = androidx.compose.ui.text.TextStyle(color = Color.White, fontSize = 17.sp),
        colors = fieldColors()
    )
}

@Composable
fun AnalyzerLayout(title: String, onBack: () -> Unit, content: @Composable ColumnScope.() -> Unit) {
    Column(
        modifier = Modifier.fillMaxSize().background(Background)
            .verticalScroll(rememberScrollState()).padding(20.dp)
    ) {
        Button(onClick = onBack, colors = ButtonDefaults.buttonColors(containerColor = CardColor)) {
            Text("← Back to Home", color = Color.White, fontSize = 16.sp)
        }
        Spacer(Modifier.height(20.dp))
        Text(title, color = Accent, fontSize = 24.sp)
        Spacer(Modifier.height(25.dp))
        content()
    }
}

@Composable
fun ActionButton(title: String, onClick: () -> Unit) {
    Button(onClick = onClick, modifier = Modifier.fillMaxWidth(),
        colors = ButtonDefaults.buttonColors(containerColor = Accent)) {
        Text(title, color = Color.Black, fontSize = 19.sp)
    }
}

@Composable
fun ResultCard(heading: String, explanation: String, probability: Double) {
    Spacer(Modifier.height(22.dp))
    Card(modifier = Modifier.fillMaxWidth(), colors = CardDefaults.cardColors(containerColor = CardColor)) {
        Column(modifier = Modifier.padding(20.dp), horizontalAlignment = Alignment.CenterHorizontally) {
            Text(heading, color = Accent, fontSize = 22.sp)
            Spacer(Modifier.height(15.dp))
            Text(explanation, color = Color.White, fontSize = 19.sp)
            Spacer(Modifier.height(18.dp))
            Text("AI estimate: ${String.format(Locale.US, "%.1f", probability * 100)}%",
                color = Color.LightGray, fontSize = 17.sp)
            Spacer(Modifier.height(12.dp))
            Text("This is an AI estimate, not a safety guarantee.", color = Color.Yellow, fontSize = 14.sp)
        }
    }
}

@Composable
fun fieldColors() = OutlinedTextFieldDefaults.colors(
    focusedTextColor = Color.White, unfocusedTextColor = Color.White,
    cursorColor = Accent, focusedBorderColor = Accent, unfocusedBorderColor = Color.LightGray
)









